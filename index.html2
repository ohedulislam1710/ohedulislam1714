<script>
(function(){
 const card=document.getElementById("certificateCard"), modal=document.getElementById("certModal"), close=document.getElementById("certClose");
 const lens=document.getElementById("certLens"), lensImg=document.getElementById("certLensImg"), label=document.getElementById("lensLabel");
 if(card&&modal){
   card.onclick=(e)=>{ if(!card.dataset.magnifying) modal.classList.add("open"); card.dataset.magnifying=""; };
   if(close) close.onclick=()=>modal.classList.remove("open");
   modal.onclick=e=>{if(e.target===modal)modal.classList.remove("open")};
   document.addEventListener("keydown",e=>{if(e.key==="Escape")modal.classList.remove("open")});
 }
 if(card&&lens&&lensImg){
   const source=card.querySelector('img[alt*="Certificate"]');
   lensImg.src=source.src;
   function move(clientX,clientY){
     const r=card.getBoundingClientRect();
     const x=Math.max(0,Math.min(r.width,clientX-r.left));
     const y=Math.max(0,Math.min(r.height,clientY-r.top));
     lens.style.left=x+'px'; lens.style.top=y+'px';
     const ir=source.getBoundingClientRect();
     const sx=source.naturalWidth/ir.width, sy=source.naturalHeight/ir.height;
     const localX=Math.max(0,Math.min(ir.width,clientX-ir.left))*sx;
     const localY=Math.max(0,Math.min(ir.height,clientY-ir.top))*sy;
     const zoom=2.15;
     lensImg.style.width=(source.naturalWidth*zoom)+'px';
     lensImg.style.height=(source.naturalHeight*zoom)+'px';
     lensImg.style.left=(56-localX*zoom)+'px';
     lensImg.style.top=(56-localY*zoom)+'px';
     lens.style.display='block'; label.style.display='block';
   }
   function hide(){lens.style.display='none';label.style.display='none';delete card.dataset.magnifying;}
   card.addEventListener('pointermove',e=>move(e.clientX,e.clientY));
   card.addEventListener('pointerenter',e=>move(e.clientX,e.clientY));
   card.addEventListener('pointerleave',hide);
   card.addEventListener('pointerdown',e=>{card.dataset.magnifying='1';move(e.clientX,e.clientY)});
   card.addEventListener('pointerup',()=>{setTimeout(hide,1200)});
 }
 document.querySelectorAll('a[href^="#"]').forEach(a=>a.addEventListener("click",()=>{const el=document.querySelector(a.getAttribute("href"));if(el)window.scrollTo({top:el.offsetTop-70,behavior:"smooth"})}));
})();
</script>

<script id="ohe-certificate-motion">
(()=>{
 const card=document.getElementById('certificateCard');
 if(!card)return;
 const move=(x,y)=>{const r=card.getBoundingClientRect();const px=(x-r.left)/r.width-.5,py=(y-r.top)/r.height-.5;card.style.transform=`perspective(1100px) rotateX(${(-py*3.2).toFixed(2)}deg) rotateY(${(px*4).toFixed(2)}deg) translateZ(0)`};
 card.addEventListener('pointermove',e=>{if(e.pointerType==='mouse'||e.pointerType==='pen')move(e.clientX,e.clientY)});
 card.addEventListener('pointerleave',()=>{card.style.transform=''});
 card.addEventListener('touchmove',e=>{const t=e.touches[0];if(t)move(t.clientX,t.clientY)},{passive:true});
})();
</script>


<script id="ohe-profile-parallax">
(()=>{
 const photoWrap=document.querySelector('.hero-photo');
 if(!photoWrap || window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
 let raf=0,tx=0,ty=0;
 const render=()=>{
   raf=0;
   photoWrap.style.setProperty('--px',`${tx*.35}px`);
   photoWrap.style.setProperty('--py',`${ty*.35}px`);
   photoWrap.style.setProperty('--photo-px',`${tx*.18}px`);
   photoWrap.style.setProperty('--photo-py',`${ty*.18}px`);
 };
 const move=(x,y)=>{
   const r=photoWrap.getBoundingClientRect();
   tx=((x-(r.left+r.width/2))/r.width)*14;
   ty=((y-(r.top+r.height/2))/r.height)*14;
   if(!raf) raf=requestAnimationFrame(render);
 };
 const reset=()=>{
   tx=ty=0;
   if(!raf) raf=requestAnimationFrame(render);
 };
 photoWrap.addEventListener('pointermove',e=>{
   if(e.pointerType==='mouse'||e.pointerType==='pen') move(e.clientX,e.clientY);
 });
 photoWrap.addEventListener('pointerleave',reset);
})();
</script>


<style id="ohe-ultra-visual-motion">
/* ULTRA PREMIUM VISUAL LAYERS — profile + certificate only */
.hero-photo{isolation:isolate;--mx:0px;--my:0px}
.hero-photo::after{
 content:"";position:absolute;inset:-35px;z-index:-3;border-radius:50%;
 background:radial-gradient(circle,rgba(34,211,238,.18) 0,rgba(59,130,246,.10) 28%,rgba(139,92,246,.06) 48%,transparent 70%);
 filter:blur(18px);animation:oheAura 6s ease-in-out infinite;pointer-events:none
}
.hero-photo .ohe-orbit,.hero-photo .ohe-orbit2,.hero-photo .ohe-orbit3{
 position:absolute;left:50%;top:50%;width:min(510px,120%);aspect-ratio:1;z-index:-1;
 border:1px solid rgba(103,232,249,.20);border-radius:50%;pointer-events:none;
 transform:translate(-50%,-50%) translate(var(--px,0),var(--py,0)) rotateX(66deg) rotate(var(--r,0deg));
 box-shadow:0 0 22px rgba(34,211,238,.08),inset 0 0 18px rgba(59,130,246,.04);
 animation:oheOrbit 17s linear infinite
}
.hero-photo .ohe-orbit2{width:min(450px,108%);border-color:rgba(167,139,250,.16);transform:translate(-50%,-50%) translate(var(--px,0),var(--py,0)) rotateX(67deg) rotateY(14deg);animation:oheOrbitReverse 23s linear infinite}
.hero-photo .ohe-orbit3{width:min(560px,130%);border-color:rgba(255,255,255,.10);transform:translate(-50%,-50%) translate(var(--px,0),var(--py,0)) rotateX(72deg) rotateY(-18deg);animation:oheOrbit 31s linear infinite}
.hero-photo .ohe-orbit::before,.hero-photo .ohe-orbit2::before,.hero-photo .ohe-orbit3::before{
 content:"";position:absolute;width:6px;height:6px;right:10%;top:18%;border-radius:50%;
 background:#bffaff;box-shadow:0 0 10px #67e8f9,0 0 24px rgba(34,211,238,.7)
}
.hero-photo .ohe-orbit2::before{left:8%;right:auto;top:68%;background:#ddd5ff;box-shadow:0 0 10px #a78bfa,0 0 22px rgba(139,92,246,.6)}
.hero-photo .ohe-orbit3::before{width:4px;height:4px;right:18%;top:76%;background:#fff;box-shadow:0 0 12px #fff}
.hero-photo .ohe-particles{position:absolute;inset:-12%;z-index:-1;pointer-events:none;overflow:visible}
.hero-photo .ohe-particles i{
 position:absolute;width:3px;height:3px;border-radius:50%;background:#d9fbff;
 box-shadow:0 0 8px rgba(103,232,249,.9);opacity:0;
 animation:oheParticle var(--d,5s) ease-in-out infinite var(--delay,0s)
}
.hero-photo .ohe-particles i:nth-child(1){left:12%;top:28%;--d:6s;--delay:-1s}
.hero-photo .ohe-particles i:nth-child(2){left:83%;top:19%;--d:7s;--delay:-4s}
.hero-photo .ohe-particles i:nth-child(3){left:91%;top:61%;--d:5.5s;--delay:-2s}
.hero-photo .ohe-particles i:nth-child(4){left:19%;top:76%;--d:8s;--delay:-6s}
.hero-photo .ohe-particles i:nth-child(5){left:67%;top:88%;--d:6.5s;--delay:-3s}
.hero-photo .ohe-particles i:nth-child(6){left:45%;top:7%;--d:7.5s;--delay:-5s}
.hero-photo .ohe-sweep{
 position:absolute;inset:-25px;z-index:-1;border-radius:50%;pointer-events:none;
 background:conic-gradient(from 210deg,transparent 0 68%,rgba(255,255,255,.16) 72%,rgba(103,232,249,.32) 74%,transparent 78% 100%);
 -webkit-mask:radial-gradient(circle,transparent 56%,#000 57%,#000 58%,transparent 59%);
 mask:radial-gradient(circle,transparent 56%,#000 57%,#000 58%,transparent 59%);
 animation:oheSweep 9s linear infinite
}
.photo{z-index:2;transform:translate(var(--photo-px,0),var(--photo-py,0));transition:filter .35s ease}
@keyframes oheOrbit{to{transform:translate(-50%,-50%) translate(var(--px,0),var(--py,0)) rotateX(66deg) rotate(360deg)}}
@keyframes oheOrbitReverse{to{transform:translate(-50%,-50%) translate(var(--px,0),var(--py,0)) rotateX(67deg) rotateY(14deg) rotate(-360deg)}}
@keyframes oheAura{0%,100%{opacity:.55;transform:scale(.92)}50%{opacity:1;transform:scale(1.05)}}
@keyframes oheSweep{to{transform:rotate(360deg)}}
@keyframes oheParticle{0%,100%{opacity:0;transform:translate3d(0,10px,0) scale(.5)}25%{opacity:.75}55%{opacity:.25;transform:translate3d(8px,-12px,0) scale(1)}75%{opacity:.65}}

/* Certificate: elegant animated frame, particles and light sweep */
.certificate-card{isolation:isolate}
.certificate-card .ohe-cert-glow{
 position:absolute;inset:-30px;z-index:-2;border-radius:35px;pointer-events:none;
 background:radial-gradient(circle at 30% 20%,rgba(34,211,238,.14),transparent 35%),radial-gradient(circle at 75% 80%,rgba(139,92,246,.12),transparent 38%);
 filter:blur(24px);animation:oheCertGlow 7s ease-in-out infinite alternate
}
.certificate-card .ohe-cert-ring{
 position:absolute;inset:-10px;z-index:-1;border-radius:28px;pointer-events:none;
 background:conic-gradient(from 0deg,transparent 0 72%,rgba(103,232,249,.55) 76%,transparent 81%,rgba(167,139,250,.42) 88%,transparent 94%);
 -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);
 -webkit-mask-composite:xor;mask-composite:exclude;padding:1px;
 animation:oheCertSpin 10s linear infinite
}
.certificate-card .ohe-cert-sparkles{position:absolute;inset:-8px;z-index:5;pointer-events:none;overflow:visible}
.certificate-card .ohe-cert-sparkles i{
 position:absolute;width:4px;height:4px;border-radius:50%;background:#fff;opacity:0;
 box-shadow:0 0 10px #67e8f9,0 0 18px rgba(167,139,250,.5);
 animation:oheCertSpark var(--d,4s) ease-in-out infinite var(--delay,0s)
}
.certificate-card .ohe-cert-sparkles i:nth-child(1){left:8%;top:12%;--d:5s}
.certificate-card .ohe-cert-sparkles i:nth-child(2){left:92%;top:20%;--d:6s;--delay:-2s}
.certificate-card .ohe-cert-sparkles i:nth-child(3){left:87%;top:88%;--d:4.5s;--delay:-1s}
.certificate-card .ohe-cert-sparkles i:nth-child(4){left:13%;top:84%;--d:7s;--delay:-4s}
.certificate-card .ohe-cert-sweep{
 position:absolute;inset:0;z-index:3;pointer-events:none;overflow:hidden;border-radius:13px
}
.certificate-card .ohe-cert-sweep::before{
 content:"";position:absolute;top:-20%;left:-55%;width:30%;height:140%;
 transform:skewX(-20deg);
 background:linear-gradient(90deg,transparent,rgba(255,255,255,.16),rgba(103,232,249,.13),transparent);
 filter:blur(3px);animation:oheCertSweep 6.5s ease-in-out infinite
}
@keyframes oheCertGlow{from{opacity:.55;transform:scale(.97)}to{opacity:1;transform:scale(1.025)}}
@keyframes oheCertSpin{to{transform:rotate(360deg)}}
@keyframes oheCertSpark{0%,100%{opacity:0;transform:translateY(6px) scale(.4)}35%{opacity:.9}60%{opacity:.25;transform:translateY(-5px) scale(1)}}
@keyframes oheCertSweep{0%,48%{left:-55%;opacity:0}58%{opacity:1}82%,100%{left:130%;opacity:0}}

@media(max-width:800px){
 .hero-photo .ohe-orbit{width:112%}.hero-photo .ohe-orbit2{width:102%}.hero-photo .ohe-orbit3{width:122%}
 .hero-photo .ohe-particles{inset:-5%}
}
@media(prefers-reduced-motion:reduce){
 .hero-photo .ohe-orbit,.hero-photo .ohe-orbit2,.hero-photo .ohe-orbit3,.hero-photo::after,.hero-photo .ohe-sweep,
 .hero-photo .ohe-particles i,.certificate-card .ohe-cert-glow,.certificate-card .ohe-cert-ring,
 .certificate-card .ohe-cert-sparkles i,.certificate-card .ohe-cert-sweep::before{animation:none!important}
}
</style>
<script id="ohe-ultra-motion-init">
(()=>{
 const photo=document.querySelector('.hero-photo'), cert=document.getElementById('certificateCard');
 if(photo){
   const mk=(cls)=>{const e=document.createElement('div');e.className=cls;photo.appendChild(e);return e};
   mk('ohe-orbit');mk('ohe-orbit2');mk('ohe-orbit3');mk('ohe-sweep');
   const p=mk('ohe-particles');
   for(let i=0;i<6;i++)p.appendChild(document.createElement('i'));
 }
 if(cert){
   const g=document.createElement('div');g.className='ohe-cert-glow';cert.appendChild(g);
   const r=document.createElement('div');r.className='ohe-cert-ring';cert.appendChild(r);
   const s=document.createElement('div');s.className='ohe-cert-sparkles';cert.appendChild(s);
   for(let i=0;i<4;i++)s.appendChild(document.createElement('i'));
   const sw=document.createElement('div');sw.className='ohe-cert-sweep';cert.appendChild(sw);
 }
})();
</script>


<script id="ohe-complete-motion-js">
(()=>{
 const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 const bar=document.createElement('div');bar.id='ohe-progress';document.body.appendChild(bar);
 const update=()=>{
   const h=document.documentElement.scrollHeight-innerHeight;
   bar.style.transform=`scaleX(${h>0?Math.min(1,scrollY/h):0})`;
 };
 addEventListener('scroll',update,{passive:true});addEventListener('resize',update,{passive:true});update();

 // Give every major section a living ambient layer without touching its content.
 document.querySelectorAll('section, .hero').forEach((s,i)=>{
   if(!s.querySelector('.ohe-section-light')){
     const l=document.createElement('div');l.className='ohe-section-light';l.setAttribute('aria-hidden','true');s.prepend(l);
   }
 });

 // Staggered, reliable reveal for elements that already use the site's reveal class.
 if(!reduce && 'IntersectionObserver' in window){
   const io=new IntersectionObserver(es=>es.forEach(e=>{
     if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target);}
   }),{threshold:.08,rootMargin:'0px 0px -35px'});
   document.querySelectorAll('.reveal').forEach((el,i)=>{el.style.transitionDelay=`${Math.min(i%4,3)*70}ms`;io.observe(el)});
 }else document.querySelectorAll('.reveal').forEach(e=>e.classList.add('visible'));

 // Section-title illumination as it enters the viewport.
 if(!reduce && 'IntersectionObserver' in window){
   const si=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-lit');si.unobserve(e.target)}}),{threshold:.5});
   document.querySelectorAll('.section-title').forEach(e=>si.observe(e));
 }else document.querySelectorAll('.section-title').forEach(e=>e.classList.add('is-lit'));

 // Subtle desktop magnetic/parallax response, never moving content far enough to distract.
 if(!reduce && matchMedia('(hover:hover) and (pointer:fine)').matches){
   document.querySelectorAll('.card,.project,.skill,.achievement-stats>div').forEach(el=>{
     let raf=0,rx=0,ry=0;
     const render=()=>{raf=0;el.style.transform=`perspective(900px) rotateX(${rx.toFixed(2)}deg) rotateY(${ry.toFixed(2)}deg) translateY(-4px)`};
     el.addEventListener('pointermove',e=>{
       const r=el.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;
       rx=-y*2.2;ry=x*2.8;if(!raf)raf=requestAnimationFrame(render);
     });
     el.addEventListener('pointerleave',()=>{el.style.transform='';});
   });
 }
})();
</script>


<style id="ohe-ultra-unique-style">
/* OHE ULTRA UNIQUE — additive visual layer only */
:root{--ohe-cyan:#67e8f9;--ohe-blue:#60a5fa;--ohe-violet:#a78bfa}
html{scroll-behavior:smooth}
body{cursor:default}
#ohe-ambient{position:fixed;inset:0;z-index:-1;pointer-events:none;overflow:hidden;opacity:.9}
#ohe-ambient:before{content:"";position:absolute;width:55vw;height:55vw;left:-18vw;top:8vh;border-radius:50%;background:radial-gradient(circle,rgba(34,211,238,.08),transparent 65%);filter:blur(20px);animation:oheAmbientA 16s ease-in-out infinite alternate}
#ohe-ambient:after{content:"";position:absolute;width:48vw;height:48vw;right:-16vw;bottom:4vh;border-radius:50%;background:radial-gradient(circle,rgba(139,92,246,.065),transparent 65%);filter:blur(24px);animation:oheAmbientB 19s ease-in-out infinite alternate}
@keyframes oheAmbientA{to{transform:translate3d(12vw,7vh,0) scale(1.15)}}
@keyframes oheAmbientB{to{transform:translate3d(-10vw,-8vh,0) scale(1.12)}}
.ohe-cursor{position:fixed;z-index:99999;width:7px;height:7px;border-radius:50%;background:#fff;box-shadow:0 0 16px rgba(103,232,249,.9),0 0 35px rgba(96,165,250,.5);pointer-events:none;opacity:0;transform:translate(-50%,-50%)}
.ohe-cursor-ring{position:fixed;z-index:99998;width:34px;height:34px;border:1px solid rgba(103,232,249,.4);border-radius:50%;pointer-events:none;opacity:0;transform:translate(-50%,-50%);transition:width .25s,height .25s,border-color .25s,background .25s}
body.ohe-pointer .ohe-cursor,body.ohe-pointer .ohe-cursor-ring{opacity:1}
body.ohe-hover .ohe-cursor-ring{width:54px;height:54px;border-color:rgba(167,139,250,.6);background:rgba(103,232,249,.025)}
.ohe-page-noise{position:fixed;inset:0;z-index:9990;pointer-events:none;opacity:.025;background-image:url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='2' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.5'/%3E%3C/svg%3E");mix-blend-mode:soft-light}
section,.hero{position:relative;overflow:hidden}
.ohe-section-light{opacity:.7!important;transition:transform 1.2s ease,opacity .8s ease;filter:blur(1px)}
section::after,.hero::after{content:"";position:absolute;inset:auto 8% 0;height:1px;background:linear-gradient(90deg,transparent,rgba(103,232,249,.18),rgba(167,139,250,.14),transparent);transform:scaleX(.35);transform-origin:center;transition:transform 1.4s ease;pointer-events:none}
section.is-ohe-active::after,.hero.is-ohe-active::after{transform:scaleX(1)}
.section-title{position:relative}
.section-title:after{content:"";position:absolute;left:50%;bottom:-12px;width:72px;height:2px;transform:translateX(-50%) scaleX(.15);transform-origin:center;background:linear-gradient(90deg,transparent,var(--ohe-cyan),var(--ohe-violet),transparent);box-shadow:0 0 14px rgba(103,232,249,.35);transition:transform 1s cubic-bezier(.2,.8,.2,1)}
.section-title.is-lit:after{transform:translateX(-50%) scaleX(1)}
.card,.project,.skill,.achievement-stats>div,.certificate-card{will-change:transform,box-shadow;transition:transform .45s cubic-bezier(.2,.8,.2,1),box-shadow .45s ease,filter .45s ease}
.card:hover,.project:hover,.skill:hover,.achievement-stats>div:hover,.certificate-card:hover{filter:saturate(1.04)}
.ohe-shimmer{position:absolute;inset:0;pointer-events:none;overflow:hidden;border-radius:inherit;z-index:5}
.ohe-shimmer:before{content:"";position:absolute;top:-20%;left:-70%;width:28%;height:140%;transform:skewX(-22deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.12),rgba(103,232,249,.12),transparent);filter:blur(4px);animation:oheCardSweep 7.5s ease-in-out infinite}
@keyframes oheCardSweep{0%,50%{left:-70%;opacity:0}58%{opacity:1}78%,100%{left:135%;opacity:0}}
.ohe-dot-field{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:0}
.ohe-dot-field i{position:absolute;width:2px;height:2px;border-radius:50%;background:rgba(255,255,255,.6);box-shadow:0 0 9px rgba(103,232,249,.6);animation:oheDotFloat var(--d) ease-in-out var(--delay) infinite}
@keyframes oheDotFloat{0%,100%{transform:translate3d(0,12px,0) scale(.6);opacity:0}35%{opacity:.7}65%{opacity:.2}50%{transform:translate3d(var(--x),-20px,0) scale(1.15)}}
.hero .ohe-dot-field{z-index:0}.hero>*{position:relative;z-index:2}
.hero-photo{isolation:isolate}
.hero-photo:before{content:"";position:absolute;inset:-13%;border-radius:50%;background:conic-gradient(from 0deg,transparent 0 62%,rgba(103,232,249,.25),transparent 73% 100%);filter:blur(5px);animation:oheHaloRotate 12s linear infinite;z-index:-2}
.hero-photo:after{z-index:-3!important}
@keyframes oheHaloRotate{to{transform:rotate(360deg)}}
.btn{position:relative;overflow:hidden;isolation:isolate}
.btn:after{content:"";position:absolute;inset:-50% auto -50% -35%;width:20%;transform:skewX(-20deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.2),transparent);animation:oheBtnSweep 6s ease-in-out infinite;z-index:-1}
@keyframes oheBtnSweep{0%,65%{left:-35%;opacity:0}72%{opacity:1}88%,100%{left:135%;opacity:0}}
#ohe-scroll-glow{position:fixed;top:0;left:0;width:100%;height:2px;z-index:10000;transform-origin:left;background:linear-gradient(90deg,var(--ohe-cyan),var(--ohe-blue),var(--ohe-violet));box-shadow:0 0 12px rgba(103,232,249,.5)}
@media(max-width:800px){
 .ohe-cursor,.ohe-cursor-ring,.ohe-page-noise{display:none}
 #ohe-ambient{opacity:.55}
 section::after,.hero::after{left:4%;right:4%}
 .ohe-shimmer:before{animation-duration:10s}
}
@media(prefers-reduced-motion:reduce){
 html{scroll-behavior:auto}.ohe-cursor,.ohe-cursor-ring,#ohe-ambient{display:none!important}
 .ohe-shimmer:before,.hero-photo:before,.ohe-dot-field i,.btn:after{animation:none!important}
 section::after,.hero::after,.section-title:after{transition:none!important}
}
</style>
<script id="ohe-ultra-unique-js">
(()=>{
 const reduce=matchMedia('(prefers-reduced-motion:reduce)').matches;
 const body=document.body;
 const amb=document.createElement('div');amb.id='ohe-ambient';body.prepend(amb);
 const noise=document.createElement('div');noise.className='ohe-page-noise';body.appendChild(noise);
 const prog=document.createElement('div');prog.id='ohe-scroll-glow';body.appendChild(prog);
 const update=()=>{const max=document.documentElement.scrollHeight-innerHeight;prog.style.transform=`scaleX(${max>0?scrollY/max:0})`};
 addEventListener('scroll',update,{passive:true});addEventListener('resize',update,{passive:true});update();
 if(!reduce){
   const fine=matchMedia('(hover:hover) and (pointer:fine)').matches;
   if(fine){
     const dot=document.createElement('div');dot.className='ohe-cursor';body.appendChild(dot);
     const ring=document.createElement('div');ring.className='ohe-cursor-ring';body.appendChild(ring);
     let mx=-100,my=-100,rx=-100,ry=-100,raf=0;
     addEventListener('pointermove',e=>{mx=e.clientX;my=e.clientY;body.classList.add('ohe-pointer');if(!raf)raf=requestAnimationFrame(loop)});
     addEventListener('pointerleave',()=>body.classList.remove('ohe-pointer'));
     const loop=()=>{raf=0;rx+=(mx-rx)*.18;ry+=(my-ry)*.18;dot.style.left=mx+'px';dot.style.top=my+'px';ring.style.left=rx+'px';ring.style.top=ry+'px';if(Math.abs(mx-rx)+Math.abs(my-ry)>1)raf=requestAnimationFrame(loop)};
     document.querySelectorAll('a,button,.card,.project,.certificate-card,.skill').forEach(el=>{el.addEventListener('pointerenter',()=>body.classList.add('ohe-hover'));el.addEventListener('pointerleave',()=>body.classList.remove('ohe-hover'))});
   }
 }
 // Add tiny stars to sections, purely decorative.
 if(!reduce){document.querySelectorAll('section,.hero').forEach((sec,idx)=>{if(sec.querySelector('.ohe-dot-field'))return;const f=document.createElement('div');f.className='ohe-dot-field';for(let i=0;i<idx%3+3;i++){const d=document.createElement('i');d.style.left=(8+Math.random()*84)+'%';d.style.top=(12+Math.random()*76)+'%';d.style.setProperty('--x',(Math.random()*28-14)+'px');d.style.setProperty('--d',(6+Math.random()*6)+'s');d.style.setProperty('--delay',(-Math.random()*8)+'s');f.appendChild(d)}sec.prepend(f)})}
 // Elegant shine on visual cards; content untouched.
 document.querySelectorAll('.card,.project,.skill,.achievement-stats>div,.certificate-card').forEach(el=>{if(!el.querySelector('.ohe-shimmer')){const s=document.createElement('span');s.className='ohe-shimmer';s.setAttribute('aria-hidden','true');el.appendChild(s)}});
 if(!reduce && 'IntersectionObserver' in window){const io=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting){e.target.classList.add('is-ohe-active');io.unobserve(e.target)}}),{threshold:.12});document.querySelectorAll('section,.hero').forEach(s=>io.observe(s))}
})();
</script>

</body>
</html>
