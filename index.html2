<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>OHE DUL ISLAM — Personal Portfolio</title>
<meta name="description" content="OHE DUL ISLAM — Digital Marketer, Web Developer and Graphic Designer.">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
<style>
:root{--bg:#050505;--panel:#0c0c0c;--white:#fff;--gray:#a5a5a5;--line:#292929}
*{box-sizing:border-box;scroll-behavior:smooth}
body{margin:0;background:var(--bg);color:var(--white);font-family:Inter,Arial,sans-serif;overflow-x:hidden}
body:before{content:"";position:fixed;inset:0;z-index:-2;background:radial-gradient(circle at 75% 15%,#ffffff0d,transparent 25%),radial-gradient(circle at 15% 75%,#ffffff08,transparent 28%),#050505}
body:after{content:"";position:fixed;inset:0;z-index:-1;pointer-events:none;background-image:linear-gradient(#ffffff04 1px,transparent 1px),linear-gradient(90deg,#ffffff04 1px,transparent 1px);background-size:70px 70px;mask-image:linear-gradient(to bottom,#000,transparent 90%)}
a{color:inherit;text-decoration:none}.container{width:min(1180px,92%);margin:auto}
header{position:fixed;top:0;left:0;right:0;z-index:50;background:#050505d9;backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
nav{height:76px;display:flex;align-items:center;justify-content:space-between}.logo{font-size:19px;font-weight:900}.logo b{border:1px solid #888;border-radius:50%;padding:5px;margin-right:7px;font-size:12px}
.navlinks{display:flex;gap:27px;color:#aaa;font-size:13px;font-weight:600}.navlinks a{transition:.25s}.navlinks a:hover,.navlinks a.active{color:#fff}
.navbtn{border:1px solid #555;padding:10px 17px;border-radius:9px;font-weight:800;transition:.3s}.navbtn:hover{background:#fff;color:#000;transform:translateY(-2px)}
.hero{min-height:100vh;padding-top:120px;display:grid;grid-template-columns:1.05fr .95fr;align-items:center;gap:55px;position:relative}
.hero-copy{animation:up .9s both}.eyebrow{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#aaa;font-weight:800}
h1{font-size:clamp(55px,8vw,100px);line-height:.88;letter-spacing:-5px;margin:18px 0;font-weight:900}h1 span{color:#aaa}
.role{font-size:21px;color:#ddd;font-weight:700}.desc{color:#999;max-width:650px;line-height:1.85;font-size:16px;margin-top:18px}
.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:29px}.btn{padding:14px 21px;border:1px solid #3a3a3a;border-radius:9px;font-weight:800;transition:.3s}.btn:hover{transform:translateY(-4px);border-color:#aaa;box-shadow:0 15px 35px #000}.primary{background:#fff;color:#000;border-color:#fff}
.hero-photo{position:relative;display:flex;justify-content:center;animation:up 1s .15s both}.hero-photo:before{content:"";position:absolute;width:360px;height:360px;border-radius:50%;background:#fff08;filter:blur(70px);animation:pulse 4s ease-in-out infinite}
.photo{position:relative;width:min(470px,100%);aspect-ratio:4/5;object-fit:cover;border-radius:28px;border:1px solid #383838;filter:contrast(1.04) saturate(1.08);box-shadow:0 30px 100px #000;animation:float 6s ease-in-out infinite}
.ring{position:absolute;inset:-18px;border:1px solid #ffffff1c;border-radius:34px;animation:spin 18s linear infinite}
.photo-tag{position:absolute;z-index:2;bottom:22px;left:0;background:#0b0b0bf2;border:1px solid #333;border-radius:12px;padding:13px 17px;font-size:12px;color:#aaa}.photo-tag strong{display:block;color:#fff;font-size:14px;margin-bottom:3px}
section{padding:105px 0;position:relative}.section-head{margin-bottom:40px}.section-title{font-size:44px;letter-spacing:-2px;margin:8px 0 0}
.light{background:#f4f4f4;color:#111}.light .eyebrow{color:#666}.light .section-title{color:#111}
.about-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:65px;align-items:center}.about-img{width:100%;max-width:390px;border-radius:22px;filter:saturate(1.05);border:1px solid #ccc;box-shadow:15px 20px 50px #0002}
.text{color:#555;line-height:1.85;font-size:16px}.info{display:grid;grid-template-columns:repeat(2,1fr);gap:12px;margin-top:25px}.info div{padding:15px;border:1px solid #ddd;border-radius:12px;background:#fff}.info small{display:block;color:#888;margin-bottom:5px}.info b{font-size:14px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.card{background:linear-gradient(145deg,#111,#090909);border:1px solid #222;border-radius:18px;padding:26px;transition:.35s;position:relative;overflow:hidden}.card:before{content:"";position:absolute;inset:0;background:linear-gradient(120deg,transparent,#ffffff08,transparent);transform:translateX(-120%);transition:.7s}.card:hover:before{transform:translateX(120%)}.card:hover{transform:translateY(-7px);border-color:#666;box-shadow:0 20px 50px #000}.icon{font-size:26px;color:#ddd}.card h3{font-size:19px;margin:15px 0 8px}.card p{color:#999;line-height:1.65;margin:0;font-size:14px}
.portfolio .card{min-height:215px;display:flex;flex-direction:column;justify-content:flex-end;background:radial-gradient(circle at 80% 20%,#333,#0a0a0a 60%)}.project{font-size:10px;letter-spacing:2px;color:#aaa;font-weight:800}
.skills-grid{display:grid;grid-template-columns:.65fr 1.35fr;gap:70px}.skill{margin:23px 0}.skill-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:9px;font-size:14px}.percent{color:#111;font-weight:800;opacity:0;transform:translateY(6px)}.percent.show{animation:pop .5s forwards}
.bar{height:8px;border-radius:20px;background:#d7d7d7;overflow:hidden;border:1px solid #ccc}.bar i{display:block;width:0;height:100%;background:linear-gradient(90deg,#555,#111,#555);background-size:200% 100%;border-radius:20px;animation:shine 2.5s linear infinite}.skill-note{color:#888;line-height:1.8;font-size:15px}
.contact{text-align:center;background:#080808;border-top:1px solid #222;border-bottom:1px solid #222}.contact p{color:#888;line-height:1.8;max-width:650px;margin:0 auto 25px}.contact-details{display:flex;justify-content:center;gap:25px;flex-wrap:wrap;margin:15px 0 25px;color:#bbb;font-size:14px}.contact-details a:hover{color:#fff}
footer{padding:28px 0;color:#666;font-size:12px}.footer-inner{display:flex;justify-content:space-between;gap:20px}
.reveal{opacity:0;transform:translateY(35px);transition:opacity .8s ease,transform .8s ease}.reveal.visible{opacity:1;transform:none}
@keyframes up{from{opacity:0;transform:translateY(35px)}to{opacity:1;transform:none}}@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-9px)}}@keyframes pulse{0%,100%{opacity:.25;transform:scale(.9)}50%{opacity:.65;transform:scale(1.1)}}@keyframes spin{to{transform:rotate(360deg)}}@keyframes shine{to{background-position:200% 0}}@keyframes pop{to{opacity:1;transform:none}}
@media(max-width:800px){.navlinks{display:none}.hero,.about-grid,.skills-grid{grid-template-columns:1fr}.hero{text-align:center;padding-top:110px}.desc{margin-left:auto;margin-right:auto}.actions{justify-content:center}.hero-photo{margin-top:25px}.grid{grid-template-columns:1fr}.info{grid-template-columns:1fr}h1{font-size:64px}.footer-inner{flex-direction:column}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation:none!important;transition:none!important;scroll-behavior:auto!important}.reveal{opacity:1;transform:none}}

.certificate-grid{display:grid;grid-template-columns:1.25fr .75fr;gap:20px;margin-top:28px}
.certificate-card{background:#0d0d0e;border:1px solid #29292c;border-radius:20px;padding:14px;cursor:pointer;overflow:hidden}
.certificate-card img{width:100%;display:block;border-radius:12px;transition:.45s}
.certificate-card:hover img{transform:scale(1.02)}
.certificate-caption{color:#999;font-size:12px;padding:12px 4px 2px}
.achievement-stats{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.achievement-stats div{background:#0d0d0e;border:1px solid #29292c;border-radius:18px;padding:25px;display:flex;flex-direction:column;justify-content:center;min-height:145px;transition:.3s}
.achievement-stats div:hover{transform:translateY(-5px);border-color:#777}
.achievement-stats b{font-size:34px;color:#111}
.achievement-stats span{font-size:12px;color:#777;margin-top:7px}
.cert-modal{position:fixed;inset:0;background:#000e;backdrop-filter:blur(12px);z-index:999;display:none;align-items:center;justify-content:center;padding:24px}
.cert-modal.open{display:flex}
.cert-modal img{max-width:1050px;max-height:88vh;width:100%;object-fit:contain;border-radius:12px}
.cert-close{position:absolute;right:22px;top:18px;background:#111;color:#fff;border:1px solid #555;border-radius:8px;padding:9px 14px;cursor:pointer}
@media(max-width:800px){.certificate-grid{grid-template-columns:1fr}.achievement-stats{grid-template-columns:1fr 1fr}}

/* Premium skills animation */
.skills-grid{display:grid;grid-template-columns:.72fr 1.28fr;gap:70px;align-items:start}
.skill{margin:25px 0}
.skill-top{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px;font-size:14px;font-weight:700}
.skill-top .percent{font-variant-numeric:tabular-nums;color:#111;font-weight:900}
.bar{height:10px;background:#d7d7d7;border-radius:999px;overflow:hidden;box-shadow:inset 0 1px 3px #0002}
.bar i{display:block;height:100%;width:0;border-radius:999px;background:linear-gradient(90deg,#171717,#777,#171717);background-size:220% 100%;box-shadow:0 0 14px #7778;position:relative}
.bar i:after{content:"";position:absolute;right:0;top:1px;width:9px;height:8px;border-radius:50%;background:#fff;box-shadow:0 0 10px #fff}
.skill.animate .bar i{animation:skillFill 1.9s cubic-bezier(.2,.8,.2,1) forwards,barShimmer 2.2s linear infinite 1.9s}
.skill.animate .percent{animation:percentPop .5s ease both}
@keyframes skillFill{from{width:0}to{width:var(--skill-width)}}
@keyframes barShimmer{to{background-position:220% 0}}
@keyframes percentPop{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}


/* Premium certificate presentation */
.certificate-grid{grid-template-columns:minmax(0,1.55fr) minmax(280px,.75fr);align-items:center;gap:28px}
.certificate-card{max-width:760px;margin:auto;background:linear-gradient(145deg,#181818,#090909);border:1px solid #353535;border-radius:22px;padding:16px;box-shadow:0 24px 70px #0007;transition:.4s}
.certificate-card:hover{transform:translateY(-6px);border-color:#777;box-shadow:0 32px 85px #0009}
.certificate-card img{width:100%;aspect-ratio:1.414/1;object-fit:cover;object-position:center;border-radius:13px;background:#fff;display:block}
.certificate-caption{text-align:center;padding:12px 4px 2px;color:#aaa;font-size:12px}
.achievement-stats{align-self:stretch}
.achievement-stats div{background:linear-gradient(145deg,#151515,#090909);border:1px solid #303030;box-shadow:0 16px 35px #0004}
.achievement-stats b{color:#fff}
.achievement-stats span{color:#a5a5a5}


/* High-contrast project statistics */
.stat,.achievement-stats div{position:relative;overflow:hidden}
.stat:before,.achievement-stats div:before{content:"";position:absolute;inset:0;background:linear-gradient(135deg,#ffffff0b,transparent 55%);pointer-events:none}
.stat strong,.achievement-stats b{position:relative;z-index:1;text-shadow:0 2px 14px #000}
.stat span,.achievement-stats span{position:relative;z-index:1}


body{font-family:"Inter","Noto Sans Bengali",system-ui,sans-serif;letter-spacing:.005em}
h1,h2,h3,.logo,.btn,.navbtn{font-family:"Inter","Noto Sans Bengali",sans-serif}
h1{font-weight:900;letter-spacing:-.055em}
.section-title{font-weight:850;letter-spacing:-.035em}
.roles{letter-spacing:-.01em}
.text,.desc,.section-sub,.card p{font-family:"Noto Sans Bengali","Inter",sans-serif}


@media(max-width:800px){
  .skills-grid{grid-template-columns:1fr;gap:25px}
  .certificate-grid{grid-template-columns:1fr}
  .certificate-card{max-width:100%;padding:11px}
}


/* === Universal responsive enhancement === */
html{width:100%;overflow-x:hidden} body{width:100%;min-width:0}
img,svg,video,canvas{max-width:100%;height:auto}.container{max-width:1180px;width:min(92%,1180px)}
nav{gap:14px;min-width:0}.logo{white-space:nowrap;min-width:0}.navlinks{gap:clamp(12px,2vw,28px);flex-wrap:wrap}.navbtn{white-space:nowrap}
.hero{min-height:calc(100vh - 76px);gap:clamp(35px,7vw,90px)}
.hero-copy,.hero-photo,.card,.project,.service,.about-grid>*,.skills-grid>*{min-width:0}
.hero-photo{max-width:520px;margin-left:auto;margin-right:auto}.photo{max-width:100%;height:auto}
.actions,.contact-details{flex-wrap:wrap}.btn{max-width:100%}
.grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr))}
.services-grid,.portfolio-grid{grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr))}
.info{grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr))}
.certificate-grid{grid-template-columns:minmax(0,1.55fr) minmax(0,.75fr)}
.achievement-stats{grid-template-columns:repeat(2,minmax(0,1fr))}
section{scroll-margin-top:90px}
@media(max-width:1050px){
  .container{width:min(94%,1180px)}
  nav{height:70px}.hero{gap:40px}
  h1{font-size:clamp(48px,7vw,76px)}
  .skills-grid{gap:40px}
}
@media(max-width:800px){
  .container{width:min(94%,700px)}
  header{background:#050505ee}
  nav{height:64px;gap:8px}
  .logo{font-size:15px}.logo b{padding:5px}
  .navlinks{display:flex;position:absolute;left:3%;right:3%;top:64px;padding:10px;background:#0b0b0bf7;border:1px solid #292929;border-radius:0 0 14px 14px;justify-content:center;gap:8px;flex-wrap:wrap;box-shadow:0 15px 35px #0008}
  .navlinks a{padding:8px 9px;font-size:12px}
  .navbtn{font-size:12px;padding:9px 11px}
  .hero{min-height:auto;padding-top:105px;padding-bottom:55px;text-align:center;grid-template-columns:1fr!important;gap:24px}
  .hero-copy{order:1}.hero-photo{order:2;width:min(78vw,380px)}
  h1{font-size:clamp(42px,12vw,64px);line-height:.98}
  .role{font-size:14px;line-height:1.6}.desc{font-size:14px;line-height:1.75}
  .actions{justify-content:center;gap:10px}.btn{padding:11px 15px;font-size:13px}
  .section-title{font-size:clamp(30px,8vw,44px)}
  .section-sub{font-size:13px;line-height:1.7}
  .certificate-grid{grid-template-columns:1fr;gap:18px}.certificate-card{width:100%}
  .achievement-stats{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.achievement-stats div{min-height:120px;padding:18px}.achievement-stats b{font-size:28px}
  .contact-details{gap:12px;font-size:13px}
  .footer-inner{align-items:center;text-align:center}
}
@media(max-width:480px){
  .container{width:92%}.logo{font-size:13px}.logo b{display:none}.navbtn{padding:8px 9px}
  .navlinks{left:2%;right:2%;gap:4px}.navlinks a{font-size:11px;padding:7px 6px}
  .hero{padding-top:96px}.hero-photo{width:min(82vw,330px)}
  .actions{flex-direction:column;align-items:stretch}.btn{width:100%;text-align:center}
  .achievement-stats{grid-template-columns:1fr}.achievement-stats div{min-height:105px}
  .certificate-card{padding:8px;border-radius:16px}.certificate-card img{border-radius:10px}
  .cert-modal{padding:10px}.cert-modal img{max-height:82vh}.cert-close{right:10px;top:10px}
  .contact-details{flex-direction:column;align-items:center}.skill{margin:20px 0}
}
@media(min-width:801px){.navlinks{display:flex!important}}
@media(hover:none){.certificate-card:hover,.achievement-stats div:hover{transform:none}.certificate-card:hover img{transform:none}}
@media(prefers-reduced-motion:reduce){.navlinks{scroll-behavior:auto}}

/* --- OHEDULISLAM premium identity + certificate touch magnifier --- */
.logo{display:inline-flex;align-items:center;gap:10px;text-decoration:none;letter-spacing:.02em}
.logo-photo{width:38px;height:38px;border-radius:50%;object-fit:cover;border:1px solid rgba(255,255,255,.28);box-shadow:0 0 0 3px rgba(255,255,255,.04),0 8px 25px rgba(0,0,0,.35)}
.logo span{font-weight:950;white-space:nowrap}
.certificate-card{position:relative;touch-action:none;user-select:none}
.certificate-card .cert-lens{position:absolute;z-index:8;width:112px;height:112px;border-radius:50%;pointer-events:none;display:none;overflow:hidden;border:3px solid rgba(255,255,255,.88);box-shadow:0 10px 35px rgba(0,0,0,.55),inset 0 0 0 1px rgba(255,255,255,.35);backdrop-filter:blur(1px);transform:translate(-50%,-50%)}
.certificate-card .cert-lens::after{content:"";position:absolute;inset:0;border-radius:50%;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.28),transparent 35%,rgba(0,0,0,.12) 100%);mix-blend-mode:screen}
.certificate-card .cert-lens img{position:absolute;max-width:none;width:auto;height:auto;border-radius:0;transform-origin:0 0;transition:none;pointer-events:none}
.certificate-card .lens-label{position:absolute;z-index:9;pointer-events:none;display:none;left:50%;top:calc(50% + 70px);transform:translateX(-50%);font:700 9px/1 Inter,sans-serif;letter-spacing:.12em;text-transform:uppercase;color:#fff;background:rgba(0,0,0,.62);padding:5px 8px;border-radius:999px;white-space:nowrap;border:1px solid rgba(255,255,255,.12)}
@media(max-width:600px){.logo-photo{width:32px;height:32px}.logo{gap:7px}.logo span{font-size:12px}.certificate-card .cert-lens{width:96px;height:96px}}
</style>

<style id="ohe-premium-certificate-animation">
/* Premium certificate motion layer */
.certificate-grid{position:relative;isolation:isolate}
.certificate-grid::before,.certificate-grid::after{content:"";position:absolute;inset:8% 18%;border-radius:40px;pointer-events:none;z-index:-2}
.certificate-grid::before{background:conic-gradient(from 0deg,transparent 0 22%,rgba(99,102,241,.22),transparent 38% 62%,rgba(14,165,233,.18),transparent 78%);filter:blur(28px);animation:oheSpin 12s linear infinite}
.certificate-grid::after{background:radial-gradient(circle at 20% 30%,rgba(255,255,255,.8),transparent 22%),radial-gradient(circle at 80% 70%,rgba(99,102,241,.18),transparent 26%);filter:blur(22px);animation:oheFloat 7s ease-in-out infinite alternate}
.certificate-card{position:relative;overflow:hidden;transform-style:preserve-3d;transition:transform .18s ease,box-shadow .35s ease}
.certificate-card::before{content:"";position:absolute;inset:-2px;background:linear-gradient(115deg,transparent 20%,rgba(255,255,255,.75) 48%,transparent 56%);transform:translateX(-130%);animation:oheShine 5.5s ease-in-out infinite;pointer-events:none;z-index:3;mix-blend-mode:screen}
.certificate-card::after{content:"✦  ✧  ✦  ✧  ✦";position:absolute;top:12px;right:18px;letter-spacing:10px;font-size:12px;opacity:.5;animation:oheSpark 3s ease-in-out infinite;pointer-events:none;z-index:4}
.cert-lens{box-shadow:0 0 0 1px rgba(255,255,255,.75),0 18px 55px rgba(15,23,42,.24),inset 0 0 30px rgba(255,255,255,.25);backdrop-filter:blur(2px);-webkit-backdrop-filter:blur(2px)}
.cert-lens::before{content:"";position:absolute;inset:7px;border:1px solid rgba(255,255,255,.8);border-radius:inherit;pointer-events:none;z-index:5}
.lens-label{letter-spacing:.18em;font-weight:800;text-shadow:0 1px 8px rgba(0,0,0,.22);animation:ohePulse 2.2s ease-in-out infinite}
.certificate-card .certificate-image,.certificate-card>img{transition:filter .45s ease,transform .6s cubic-bezier(.2,.8,.2,1)}
.certificate-card:hover .certificate-image,.certificate-card:hover>img{transform:scale(1.018);filter:saturate(1.05) contrast(1.02)}
@keyframes oheShine{0%,58%{transform:translateX(-130%)}78%,100%{transform:translateX(130%)}}
@keyframes oheSpin{to{transform:rotate(360deg)}}
@keyframes oheFloat{from{transform:translate3d(-10px,-6px,0) scale(.98)}to{transform:translate3d(10px,8px,0) scale(1.02)}}
@keyframes oheSpark{0%,100%{transform:translateY(0) rotate(0);opacity:.35}50%{transform:translateY(-5px) rotate(4deg);opacity:.85}}
@keyframes ohePulse{0%,100%{opacity:.65;transform:scale(.98)}50%{opacity:1;transform:scale(1.03)}}
@media (prefers-reduced-motion:reduce){.certificate-grid::before,.certificate-grid::after,.certificate-card::before,.certificate-card::after,.lens-label{animation:none!important}.certificate-card{transition:none}}
</style>


<style id="ohe-profile-ambient-animation">
/* === Profile-only premium ambient motion layer === */
.hero-photo{isolation:isolate;--px:0px;--py:0px}
.hero-photo .photo-ambient{position:absolute;inset:-7%;z-index:0;pointer-events:none;transform:translate3d(var(--px),var(--py),0);transition:transform .18s ease-out;will-change:transform}
.hero-photo .photo-ambient::before{content:"";position:absolute;left:50%;top:50%;width:74%;aspect-ratio:1;border-radius:50%;transform:translate(-50%,-50%);background:radial-gradient(circle,rgba(28,211,214,.17) 0,rgba(77,166,255,.10) 30%,rgba(135,91,255,.055) 51%,transparent 72%);filter:blur(22px);animation:oheAura 7s ease-in-out infinite}
.hero-photo .photo-ambient::after{content:"";position:absolute;left:50%;top:50%;width:70%;aspect-ratio:1;border-radius:50%;transform:translate(-50%,-50%);border:1px solid rgba(91,220,231,.16);box-shadow:0 0 45px rgba(49,194,220,.10),inset 0 0 30px rgba(104,132,255,.06);animation:oheBreath 5.5s ease-in-out infinite}
.hero-photo .photo-orbit{position:absolute;left:50%;top:50%;width:68%;height:68%;border:1px solid rgba(119,226,235,.18);border-radius:50%;transform:translate(-50%,-50%) rotate(22deg);box-shadow:0 0 16px rgba(70,206,226,.08);animation:oheOrbit 16s linear infinite}
.hero-photo .photo-orbit:nth-child(2){width:82%;height:47%;transform:translate(-50%,-50%) rotate(-28deg);border-color:rgba(117,174,255,.16);animation-duration:21s;animation-direction:reverse}
.hero-photo .photo-orbit:nth-child(3){width:91%;height:61%;transform:translate(-50%,-50%) rotate(61deg);border-color:rgba(178,145,255,.12);animation-duration:27s}
.hero-photo .photo-orbit i{position:absolute;top:50%;left:-3px;width:6px;height:6px;border-radius:50%;background:#bdfcff;box-shadow:0 0 8px #65e7ee,0 0 18px rgba(91,216,255,.55);transform:translateY(-50%)}
.hero-photo .photo-orbit:nth-child(2) i{left:auto;right:-3px;background:#d8e6ff;box-shadow:0 0 8px #91b9ff,0 0 18px rgba(91,145,255,.5)}
.hero-photo .photo-orbit:nth-child(3) i{left:50%;top:-3px;background:#e8dcff;box-shadow:0 0 8px #b99cff,0 0 16px rgba(150,110,255,.42)}
.hero-photo .photo-sweep{position:absolute;left:50%;top:50%;width:94%;height:94%;border-radius:50%;transform:translate(-50%,-50%) rotate(0deg);background:conic-gradient(from 0deg,transparent 0 72%,rgba(116,229,235,.0) 78%,rgba(116,229,235,.18) 83%,transparent 89%);filter:blur(.3px);animation:oheSweep 9s linear infinite}
.hero-photo .photo-particles{position:absolute;inset:4%;overflow:visible}
.hero-photo .photo-particles i{position:absolute;width:3px;height:3px;border-radius:50%;background:rgba(202,249,255,.8);box-shadow:0 0 7px rgba(103,228,238,.75);animation:oheParticle 5s ease-in-out infinite}
.hero-photo .photo-particles i:nth-child(1){left:12%;top:20%;animation-delay:-1s}.hero-photo .photo-particles i:nth-child(2){left:79%;top:16%;animation-delay:-3.4s}
.hero-photo .photo-particles i:nth-child(3){left:87%;top:48%;animation-delay:-2s}.hero-photo .photo-particles i:nth-child(4){left:15%;top:68%;animation-delay:-4s}
.hero-photo .photo-particles i:nth-child(5){left:76%;top:79%;animation-delay:-.7s}.hero-photo .photo-particles i:nth-child(6){left:34%;top:9%;animation-delay:-2.7s}
.hero-photo .photo-particles i:nth-child(7){left:8%;top:44%;animation-delay:-1.8s}.hero-photo .photo-particles i:nth-child(8){left:61%;top:92%;animation-delay:-3.8s}
.hero-photo .photo-particles i:nth-child(9){left:92%;top:72%;animation-delay:-1.3s}.hero-photo .photo-particles i:nth-child(10){left:48%;top:5%;animation-delay:-4.4s}
.hero-photo .photo-particles i:nth-child(11){left:25%;top:89%;animation-delay:-2.2s}.hero-photo .photo-particles i:nth-child(12){left:69%;top:37%;animation-delay:-.9s}
.hero-photo .photo-aura{position:absolute;left:50%;top:50%;width:72%;height:72%;transform:translate(-50%,-50%);border-radius:50%;border:1px solid rgba(255,255,255,.08);box-shadow:0 0 0 8px rgba(255,255,255,.012),0 0 50px rgba(46,204,211,.09);z-index:1}
.hero-photo>.ring,.hero-photo>.photo{z-index:2}
.hero-photo .photo{transform:translate3d(var(--photo-px,0px),var(--photo-py,0px),0);will-change:transform}
.hero-photo>.photo-tag{z-index:4}
@keyframes oheAura{0%,100%{opacity:.55;transform:translate(-50%,-50%) scale(.93)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.06)}}
@keyframes oheBreath{0%,100%{opacity:.55;transform:translate(-50%,-50%) scale(.96)}50%{opacity:1;transform:translate(-50%,-50%) scale(1.03)}}
@keyframes oheOrbit{to{transform:translate(-50%,-50%) rotate(382deg)}}
@keyframes oheSweep{to{transform:translate(-50%,-50%) rotate(360deg)}}
@keyframes oheParticle{0%,100%{opacity:0;transform:translate3d(0,8px,0) scale(.5)}30%,70%{opacity:.8}50%{transform:translate3d(5px,-9px,0) scale(1)}}
@media(max-width:800px){
 .hero-photo .photo-ambient{inset:-9%;transition:none}
 .hero-photo .photo-orbit:nth-child(2){width:88%;height:50%}
 .hero-photo .photo-orbit:nth-child(3){width:96%;height:64%}
}
@media(prefers-reduced-motion:reduce){
 .hero-photo .photo-ambient,.hero-photo .photo,.hero-photo .photo-ambient *{animation:none!important;transition:none!important}
 .hero-photo .photo{transform:none!important}
}
</style>


<style id="ohe-ultimate-motion">
/* OHE ULTIMATE — site-wide premium motion layer (visual only) */
html{scroll-behavior:smooth}
body{--mx:50%;--my:20%;position:relative}
body::before{content:"";position:fixed;inset:-20%;z-index:-3;pointer-events:none;background:radial-gradient(420px circle at var(--mx) var(--my),rgba(34,211,238,.075),transparent 60%),radial-gradient(520px circle at 82% 18%,rgba(139,92,246,.055),transparent 65%);animation:oheAmbient 14s ease-in-out infinite alternate}
body::after{z-index:-4;background-image:radial-gradient(circle,rgba(255,255,255,.055) 1px,transparent 1px),linear-gradient(#ffffff03 1px,transparent 1px),linear-gradient(90deg,#ffffff03 1px,transparent 1px);background-size:120px 120px,70px 70px,70px 70px;animation:oheGrid 24s linear infinite}
header{transition:background .35s ease,box-shadow .35s ease,transform .35s ease}
header.scrolled{box-shadow:0 12px 45px rgba(0,0,0,.32);background:#050505ec}
.navlinks a{position:relative}.navlinks a::after{content:"";position:absolute;left:50%;bottom:-5px;width:0;height:1px;background:linear-gradient(90deg,#67e8f9,#fff,#a78bfa);transform:translateX(-50%);transition:width .35s ease}.navlinks a:hover::after,.navlinks a.active::after{width:75%}
.hero-copy,.hero-photo,.section-head,.about-grid>*,.skills-grid>*,.card,.certificate-grid,.contact-details,.contact .btn,footer{will-change:transform}
.reveal{transition:opacity .85s cubic-bezier(.2,.8,.2,1),transform .85s cubic-bezier(.2,.8,.2,1),filter .85s ease}.reveal:not(.visible){filter:blur(4px)}
.reveal.visible{filter:blur(0)}
.card,.certificate-card,.achievement-stats div,.btn{position:relative;isolation:isolate}
.card::after,.certificate-card::after,.achievement-stats div::after{content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;background:linear-gradient(120deg,transparent 15%,rgba(103,232,249,.28),transparent 42%,rgba(167,139,250,.22),transparent 72%);-webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;opacity:0;transition:opacity .45s ease;pointer-events:none;z-index:2}
.card:hover::after,.certificate-card:hover::after,.achievement-stats div:hover::after{opacity:1}
.card,.achievement-stats div{transition:transform .45s cubic-bezier(.2,.8,.2,1),border-color .35s ease,box-shadow .45s ease}
.btn{overflow:hidden}.btn::before{content:"";position:absolute;top:-120%;left:-35%;width:28%;height:340%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.34),transparent);transform:rotate(20deg);transition:transform .8s ease;pointer-events:none}.btn:hover::before{transform:translateX(430%) rotate(20deg)}
.hero-photo::after{content:"";position:absolute;width:76%;height:76%;border-radius:50%;background:radial-gradient(circle,rgba(34,211,238,.09),transparent 66%);filter:blur(25px);z-index:-1;animation:ohePhotoGlow 5s ease-in-out infinite alternate}
.section-title{position:relative}.section-title::after{content:"";display:block;width:58px;height:2px;margin-top:13px;background:linear-gradient(90deg,#67e8f9,#a78bfa,transparent);transform-origin:left;animation:oheLine 4s ease-in-out infinite}
.skill{transition:transform .3s ease}.skill:hover{transform:translateX(5px)}
.certificate-grid{filter:drop-shadow(0 18px 45px rgba(0,0,0,.16))}
.contact{overflow:hidden}.contact::before{content:"";position:absolute;width:480px;height:480px;left:50%;top:50%;transform:translate(-50%,-50%);border-radius:50%;background:conic-gradient(from 0deg,transparent,rgba(34,211,238,.07),transparent,rgba(167,139,250,.06),transparent);filter:blur(35px);animation:oheSpinSlow 18s linear infinite;pointer-events:none}
.ohe-cursor-glow{position:fixed;width:220px;height:220px;border-radius:50%;pointer-events:none;z-index:1;background:radial-gradient(circle,rgba(103,232,249,.08),transparent 65%);transform:translate(-50%,-50%);mix-blend-mode:screen;opacity:0;transition:opacity .4s ease}
@keyframes oheAmbient{from{transform:translate3d(-1%,0,0) scale(1)}to{transform:translate3d(1%,1%,0) scale(1.04)}}
@keyframes oheGrid{to{background-position:120px 120px,0 70px,70px 0}}
@keyframes ohePhotoGlow{from{transform:scale(.88);opacity:.45}to{transform:scale(1.08);opacity:.8}}
@keyframes oheLine{0%,100%{transform:scaleX(.65);opacity:.55}50%{transform:scaleX(1);opacity:1}}
@keyframes oheSpinSlow{to{transform:translate(-50%,-50%) rotate(360deg)}}
@media(max-width:800px){body::before{animation-duration:18s}.ohe-cursor-glow{display:none}.card:hover::after,.achievement-stats div:hover::after{opacity:0}.skill:hover{transform:none}}
@media(prefers-reduced-motion:reduce){html{scroll-behavior:auto}body::before,body::after,.hero-photo::after,.section-title::after,.contact::before{animation:none!important}.reveal{filter:none!important;transition:none!important}.ohe-cursor-glow{display:none!important}.navlinks a::after{transition:none}}
</style>

<script id="ohe-ultimate-motion-js">
(()=>{
 const reduce=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
 const header=document.querySelector('header');
 const glow=document.createElement('div'); glow.className='ohe-cursor-glow'; document.body.appendChild(glow);
 const onScroll=()=>{if(header) header.classList.toggle('scrolled',window.scrollY>18)};
 onScroll(); window.addEventListener('scroll',onScroll,{passive:true});
 if(!reduce && matchMedia('(pointer:fine)').matches){
   let tx=innerWidth/2,ty=innerHeight*.2,cx=tx,cy=ty;
   addEventListener('pointermove',e=>{tx=e.clientX;ty=e.clientY;glow.style.opacity='.9';document.body.style.setProperty('--mx',e.clientX+'px');document.body.style.setProperty('--my',e.clientY+'px')},{passive:true});
   addEventListener('pointerleave',()=>glow.style.opacity='0');
   const tick=()=>{cx+=(tx-cx)*.08;cy+=(ty-cy)*.08;glow.style.left=cx+'px';glow.style.top=cy+'px';requestAnimationFrame(tick)};tick();
   document.querySelectorAll('.card,.certificate-card,.achievement-stats div').forEach(el=>{
     el.addEventListener('pointermove',e=>{const r=el.getBoundingClientRect(),x=(e.clientX-r.left)/r.width-.5,y=(e.clientY-r.top)/r.height-.5;el.style.transform=`perspective(900px) rotateX(${(-y*2.2).toFixed(2)}deg) rotateY(${(x*2.2).toFixed(2)}deg) translateY(-5px)`},{passive:true});
     el.addEventListener('pointerleave',()=>el.style.transform='');
   });
 }
 const items=document.querySelectorAll('.reveal');
 if(!reduce && 'IntersectionObserver' in window){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('visible');io.unobserve(e.target)}}),{threshold:.12,rootMargin:'0px 0px -30px'});items.forEach(x=>io.observe(x))}
 else items.forEach(x=>x.classList.add('visible'));
})();
</script>

<style id="ohe-complete-motion">
/* ===== OHE COMPLETE CINEMATIC MOTION LAYER ===== */
html{scroll-behavior:smooth}
body{overflow-x:hidden}
body::after{content:"";position:fixed;inset:0;pointer-events:none;z-index:9998;opacity:.22;background:radial-gradient(circle at 15% 20%,rgba(103,232,249,.035),transparent 28%),radial-gradient(circle at 85% 75%,rgba(139,92,246,.03),transparent 30%);animation:oheAtmos 18s ease-in-out infinite alternate}
#ohe-progress{position:fixed;top:0;left:0;width:100%;height:2px;z-index:10000;pointer-events:none;background:linear-gradient(90deg,#67e8f9,#fff,#a78bfa,#67e8f9);transform-origin:left center;transform:scaleX(0);box-shadow:0 0 12px rgba(103,232,249,.55);opacity:.9}
#ohe-progress::after{content:"";position:absolute;right:0;top:-3px;width:8px;height:8px;border-radius:50%;background:#fff;box-shadow:0 0 12px #67e8f9}
.ohe-section-light{position:absolute;inset:0;pointer-events:none;overflow:hidden;z-index:-1}
.ohe-section-light::before,.ohe-section-light::after{content:"";position:absolute;border-radius:50%;filter:blur(40px);opacity:.14;animation:oheBlob 12s ease-in-out infinite alternate}
.ohe-section-light::before{width:180px;height:180px;left:3%;top:18%;background:#22d3ee}
.ohe-section-light::after{width:150px;height:150px;right:4%;bottom:10%;background:#8b5cf6;animation-delay:-5s}
section,.hero{position:relative}
.section-title{position:relative;transition:transform .6s cubic-bezier(.2,.8,.2,1),letter-spacing .6s ease}
.section-title::before{content:"";position:absolute;width:48px;height:1px;left:0;bottom:-11px;background:linear-gradient(90deg,#67e8f9,transparent);transform-origin:left;transform:scaleX(.35);transition:transform .8s ease}
.section-title.is-lit::before{transform:scaleX(1.8)}
.card,.project,.skill,.achievement-stats>div,.about-img,.info,.contact-details,.certificate-card{
 position:relative;isolation:isolate;will-change:transform;transition:transform .55s cubic-bezier(.2,.8,.2,1),box-shadow .55s ease,border-color .55s ease,filter .55s ease
}
.card::before,.project::before,.skill::before,.achievement-stats>div::before,.about-img::before,.info::before,.contact-details::before{
 content:"";position:absolute;inset:-1px;border-radius:inherit;padding:1px;pointer-events:none;opacity:0;
 background:linear-gradient(120deg,transparent 12%,rgba(103,232,249,.55),rgba(255,255,255,.4),rgba(167,139,250,.5),transparent 82%);
 -webkit-mask:linear-gradient(#000 0 0) content-box,linear-gradient(#000 0 0);-webkit-mask-composite:xor;mask-composite:exclude;
 animation:oheBorderFlow 5.5s linear infinite
}
.card:hover::before,.project:hover::before,.skill:hover::before,.achievement-stats>div:hover::before,.info:hover::before,.contact-details:hover::before{opacity:.7}
.card:hover,.project:hover,.achievement-stats>div:hover{transform:translateY(-7px);box-shadow:0 18px 50px rgba(0,0,0,.28),0 0 28px rgba(103,232,249,.06)}
.skill:hover{transform:translateX(6px)}
.about-img:hover{transform:scale(1.018) rotate(.4deg);filter:saturate(1.08)}
.btn,.navbtn{position:relative;overflow:hidden;isolation:isolate;transition:transform .35s ease,box-shadow .35s ease}
.btn::after,.navbtn::after{content:"";position:absolute;top:-30%;left:-80%;width:42%;height:160%;transform:skewX(-20deg);background:linear-gradient(90deg,transparent,rgba(255,255,255,.28),transparent);animation:oheButtonSweep 5.8s ease-in-out infinite;pointer-events:none}
.btn:hover,.navbtn:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(103,232,249,.12)}
.navlinks a{position:relative;transition:color .3s ease,transform .3s ease}
.navlinks a:hover{transform:translateY(-1px)}
.icon{transition:transform .6s cubic-bezier(.2,.8,.2,1),filter .6s ease}
.card:hover .icon,.project:hover .icon{transform:translateY(-4px) rotate(-4deg) scale(1.08);filter:drop-shadow(0 0 10px rgba(103,232,249,.35))}
.project img{transition:transform .8s cubic-bezier(.2,.8,.2,1),filter .8s ease}
.project:hover img{transform:scale(1.045);filter:saturate(1.08) contrast(1.03)}
.bar{position:relative;overflow:hidden}
.bar::after{content:"";position:absolute;top:0;left:-40%;height:100%;width:30%;background:linear-gradient(90deg,transparent,rgba(255,255,255,.28),transparent);animation:oheBarShine 3.8s ease-in-out infinite}
.percent{transition:transform .4s ease}
.skill:hover .percent{transform:scale(1.08)}
.reveal{opacity:0;transform:translateY(28px) scale(.985);filter:blur(3px);transition:opacity .85s ease,transform .85s cubic-bezier(.2,.8,.2,1),filter .85s ease}
.reveal.visible{opacity:1;transform:none;filter:none}
.card.reveal:nth-child(2),.project.reveal:nth-child(2),.skill.reveal:nth-child(2){transition-delay:.08s}
.card.reveal:nth-child(3),.project.reveal:nth-child(3),.skill.reveal:nth-child(3){transition-delay:.16s}
.card.reveal:nth-child(4),.project.reveal:nth-child(4),.skill.reveal:nth-child(4){transition-delay:.24s}
.hero-copy>*{animation:oheHeroIn .9s cubic-bezier(.2,.8,.2,1) both}
.hero-copy .role{animation-delay:.12s}.hero-copy .desc{animation-delay:.2s}.hero-copy .actions{animation-delay:.3s}
.photo-tag{animation:oheTagFloat 4s ease-in-out infinite alternate}
footer{position:relative;overflow:hidden}
footer::before{content:"";position:absolute;left:0;right:0;top:0;height:1px;background:linear-gradient(90deg,transparent,#67e8f9,#fff,#a78bfa,transparent);background-size:200% 100%;animation:oheLineFlow 6s linear infinite;opacity:.7}
@keyframes oheAtmos{from{transform:translate3d(-1%,0,0) scale(1)}to{transform:translate3d(1%,1%,0) scale(1.035)}}
@keyframes oheBlob{from{transform:translate3d(-20px,10px,0) scale(.85);opacity:.08}to{transform:translate3d(20px,-15px,0) scale(1.12);opacity:.18}}
@keyframes oheBorderFlow{0%{background-position:0% 50%}100%{background-position:220% 50%}}
@keyframes oheButtonSweep{0%,58%{left:-80%;opacity:0}65%{opacity:1}82%,100%{left:150%;opacity:0}}
@keyframes oheBarShine{0%,55%{left:-40%;opacity:0}65%{opacity:1}85%,100%{left:130%;opacity:0}}
@keyframes oheHeroIn{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
@keyframes oheTagFloat{from{transform:translateY(-3px)}to{transform:translateY(4px)}}
@keyframes oheLineFlow{from{background-position:0 0}to{background-position:200% 0}}
@media(max-width:800px){
 body::after{opacity:.12}
 .card:hover,.project:hover,.achievement-stats>div:hover{transform:translateY(-3px)}
 .skill:hover{transform:none}
 .about-img:hover{transform:none}
 .btn:hover,.navbtn:hover{transform:none}
}
@media(prefers-reduced-motion:reduce){
 html{scroll-behavior:auto}
 body::after,#ohe-progress::after,.ohe-section-light::before,.ohe-section-light::after,
 .card::before,.project::before,.skill::before,.achievement-stats>div::before,.about-img::before,.info::before,.contact-details::before,
 .btn::after,.navbtn::after,.bar::after,footer::before,.photo-tag,.hero-copy>*{animation:none!important}
 .reveal{opacity:1!important;transform:none!important;filter:none!important;transition:none!important}
}
</style>

</head>
