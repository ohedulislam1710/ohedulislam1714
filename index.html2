<script>
const observer=new IntersectionObserver(entries=>entries.forEach(e=>{if(e.isIntersecting)e.target.classList.add('visible')}),{threshold:.12});
document.querySelectorAll('.reveal').forEach(el=>observer.observe(el));
const skillObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{
 if(!entry.isIntersecting)return;
 entry.target.querySelectorAll('.skill').forEach((s,index)=>{
   const value=Number(s.dataset.value),bar=s.querySelector('i'),pct=s.querySelector('.percent');
   setTimeout(()=>{
     bar.style.transition='width 1.7s cubic-bezier(.2,.8,.2,1)';
     bar.style.width=value+'%'; pct.classList.add('show');
     let n=0,step=Math.max(1,Math.ceil(value/45));
     const timer=setInterval(()=>{n=Math.min(value,n+step);pct.textContent=n+'%';if(n>=value)clearInterval(timer)},28);
   },index*160);
 });
 skillObserver.unobserve(entry.target);
}),{threshold:.3});
skillObserver.observe(document.querySelector('#skills'));
const sections=[...document.querySelectorAll('section[id]')],navs=[...document.querySelectorAll('.navlinks a')];
window.addEventListener('scroll',()=>{let current='home';sections.forEach(s=>{if(scrollY>=s.offsetTop-150)current=s.id});navs.forEach(a=>a.classList.toggle('active',a.getAttribute('href')==='#'+current))});

const skillSection = document.querySelector("#skills");
let skillsAnimated = false;

function animateSkills(){
  if(skillsAnimated || !skillSection) return;
  skillsAnimated = true;
  skillSection.querySelectorAll(".skill").forEach((skill,index)=>{
    const value = Number(skill.dataset.value || 0);
    const bar = skill.querySelector(".bar i");
    const pct = skill.querySelector(".percent");
    skill.style.setProperty("--skill-width", value + "%");
    setTimeout(()=>{
      skill.classList.add("animate");
      let current = 0;
      const duration = 1500;
      const start = performance.now();
      function tick(now){
        const p = Math.min((now-start)/duration,1);
        const eased = 1-Math.pow(1-p,3);
        current = Math.round(value*eased);
        pct.textContent = current + "%";
        if(p<1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
    }, index*150);
  });
}
if(skillSection){
  const skillObserver = new IntersectionObserver(entries=>{
    if(entries.some(e=>e.isIntersecting)){
      animateSkills();
      skillObserver.disconnect();
    }
  },{threshold:.25});
  skillObserver.observe(skillSection);
}

</script>

